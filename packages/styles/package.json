{
  "name": "@sourcebv/styles",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "author": {
    "name": "Source BV"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sourcebv/ui.git",
    "directory": "packages/styles"
  },
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "style": "./index.css",
  "exports": {
    ".": {
      "style": "./index.css",
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./index.css": "./index.css",
    "./base.css": "./base.css",
    "./themes/*": "./themes/*",
    "./components/*": "./components/*",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "index.css",
    "base.css",
    "themes",
    "components"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist",
    "prepublishOnly": "npm run clean && npm run typecheck && npm run build"
  },
  "peerDependencies": {
    "tailwindcss": "^4.0.0"
  },
  "dependencies": {
    "tailwind-variants": "^4.0.2"
  },
  "devDependencies": {
    "tailwindcss": "^4.3.5",
    "tsup": "^9.0.0",
    "typescript": "~6.0.3"
  }
}
